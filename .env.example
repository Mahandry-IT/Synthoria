# Synthoria — configuration du déploiement.
# cp .env.example .env, puis renseigner au minimum la section « Secrets ».
# Ce fichier est aussi passé tel quel aux conteneurs api et worker (env_file).
# Les URL internes (Ollama, Piper, Postgres) et les chemins de stockage sont fixés
# par docker-compose.yml : ne pas les redéfinir ici.

# ============================================================================
# Secrets
# ============================================================================
# Clé Gemini (génération des cours, podcasts, classement des médias).
GEMINI_API_KEY=
# YouTube Data API v3 : recherche réelle de vidéos. Sans clé, repli sur la
# recherche groundée Gemini + vérification oEmbed.
YOUTUBE_API_KEY=
# Openverse (optionnel, quota anonyme sinon).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# ============================================================================
# Modèles (Ollama)
# ============================================================================
# Tirés automatiquement au premier démarrage par le service ollama-init.
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=3

# ============================================================================
# Gemini
# ============================================================================
# FLASH et FLASH_LITE doivent rester distincts (les chaînes de repli s'en dérivent).
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=300
# Consomme un appel Gemini supplémentaire par question : activer si nécessaire.
GEMINI_USE_SEARCH_GROUNDING=false
# Limite de requêtes/minute, répartie entre api et worker (parts ci-dessous).
GEMINI_RPM_LIMIT=14
GEMINI_RPM_SHARE_API=0.7
GEMINI_RPM_SHARE_WORKER=0.3
# Chaînes de repli : [] = dérivées de GEMINI_MODEL_FLASH / FLASH_LITE.
GEMINI_CHAIN_GENERATION=[]
GEMINI_CHAIN_LIGHT=[]
GEMINI_CHAIN_SEARCH=[]
# Quota journalier par modèle, ex. {"gemini-3.6-flash": 100}.
GEMINI_MODEL_RPD_LIMITS={}
GEMINI_QUOTA_CACHE_TTL_SECONDS=30.0
GEMINI_RESPONSE_CACHE_TTL_HOURS=24

# ============================================================================
# API, ingestion et cours
# ============================================================================
REQUEST_MAX_PROMPT_LENGTH=8000
# Restreindre aux origines réelles en production, ex. ["https://studio.example.com"].
CORS_ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=30
CHROMA_COLLECTION_NAME=synthoria_documents
PDF_CHUNK_TARGET_TOKENS=400
PDF_CHUNK_OVERLAP_TOKENS=50
COURSE_TOP_K_DEFAULT=6
COURSE_QUESTION_MAX_LENGTH=15000
COURSE_PLAN_BATCH_SIZE=4
COURSE_PLAN_TTL_MINUTES=120
# express | standard | approfondi
DEFAULT_COURSE_DEPTH=approfondi
CHALLENGE_RATE_LIMIT_PER_MINUTE=10
CHAT_MESSAGE_MAX_LENGTH=1000
CHAT_DAILY_LIMIT=15
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_HISTORY_TURNS=4
CHAT_CONTEXT_MAX_CHARS=8000
CHAT_CONTEXT_TOP_SECTIONS=2

# ============================================================================
# Vidéos YouTube
# ============================================================================
YOUTUBE_TIMEOUT_SECONDS=5.0
YOUTUBE_SEARCH_MAX_RESULTS=10
YOUTUBE_RELEVANCE_LANGUAGE=fr
YOUTUBE_REGION_CODE=FR
YOUTUBE_MIN_DURATION_SECONDS=240
YOUTUBE_MAX_DURATION_SECONDS=2400
YOUTUBE_MAX_QUERIES=2
YOUTUBE_CACHE_TTL_HOURS=72
COURSE_VIDEOS_MIN=5
COURSE_VIDEOS_MAX=10
COURSE_VIDEOS_RANKING_ENABLED=true
YOUTUBE_RANKING_MIN_SCORE=40

# ============================================================================
# Podcast
# ============================================================================
PODCAST_ENABLED=true
PODCAST_AUTO_GENERATE=false
# Voix Piper téléchargée par piper-init (vérifier la licence du modèle).
PODCAST_TTS_MODEL=fr_FR-upmc-medium
PODCAST_VOICE_HOST=fr_FR-upmc-medium:0
PODCAST_VOICE_EXPERT=fr_FR-upmc-medium:1
PODCAST_DEFAULT_TARGET_MINUTES=10
PODCAST_MAX_MINUTES=60
PODCAST_MAX_SEGMENTS=40
PODCAST_SCRIPT_BATCH_SIZE=4
PODCAST_TTS_CONCURRENCY=2
PODCAST_TTS_MAX_CHARS=400
PODCAST_WORKER_POLL_SECONDS=5
PODCAST_JOB_STALE_MINUTES=20
PODCAST_MAX_ATTEMPTS=3
PODCAST_AUDIO_BITRATE=96k
PODCAST_RETENTION_DAYS=30
PODCAST_GENERATE_RATE_LIMIT_PER_MINUTE=5

# ============================================================================
# Médias (images ré-hébergées, Wikimedia Commons -> Openverse)
# ============================================================================
MEDIA_MAX_BYTES=5242880
MEDIA_RESOLVE_CONCURRENCY=4
MEDIA_RESOLVE_TIMEOUT_SECONDS=20
MEDIA_WEB_ENABLED=true
# Obligatoire pour le résolveur web (politique Wikimedia), désactivé si vide.
# Ex. "Synthoria/1.0 (https://github.com/<org>/<repo>; contact@example.com)"
MEDIA_WEB_USER_AGENT=
MEDIA_WEB_PROVIDERS=["wikimedia","openverse"]
MEDIA_WEB_MAX_CANDIDATES=5
MEDIA_WEB_MIN_WIDTH=400
MEDIA_WEB_ALLOWED_LICENSES=["cc0","pdm","by","by-sa"]
MEDIA_WEB_VERIFY_ENABLED=true
MEDIA_WEB_VERIFY_MIN_SCORE=40
MEDIA_WEB_CACHE_TTL_HOURS=168
MEDIA_WEB_TIMEOUT_SECONDS=8

# ============================================================================
# Postgres
# ============================================================================
# Mot de passe OBLIGATOIRE (le démarrage échoue s'il est vide) : fort, et sans
# caractère réservé d'URL (@ : / ? #) car il entre dans DATABASE_URL.
# Ex. : openssl rand -hex 24
POSTGRES_USER=synthoria
POSTGRES_PASSWORD=
POSTGRES_DB=synthoria

# ============================================================================
# Ports et réseau
# ============================================================================
# Seuls le studio et l'api sont publiés sur l'hôte (Ollama, Chroma, Postgres et
# Piper restent internes).
STUDIO_PORT=3000
API_PORT=8000
# DNS des conteneurs api et worker (appels sortants Gemini, YouTube, Wikimedia...).
DNS_PRIMARY=8.8.8.8
DNS_SECONDARY=1.1.1.1

# ============================================================================
# Images
# ============================================================================
# latest  = dernière version publiée de master (LLM) / main (Studio) : production, suivie par Watchtower.
# develop = dernière version publiée de develop : stack de test, à valider avant de livrer sur master/main.
# sha-<7> = version figée, pour revenir en arrière (make rollback TAG=sha-xxxxxxx).
SYNTHORIA_IMAGE_TAG=latest

# ============================================================================
# Watchtower (mise à jour automatique de studio, api, worker et piper)
# ============================================================================
# Intervalle de vérification de GHCR, en secondes.
WATCHTOWER_POLL_INTERVAL=300
# Délai d'arrêt accordé aux conteneurs (le worker termine son étape en cours).
WATCHTOWER_TIMEOUT=60s
# true = notifier sans appliquer les mises à jour.
WATCHTOWER_MONITOR_ONLY=false
# Notification (URL shoutrrr), ex. discord://token@id ou telegram://token@telegram?chats=id
WATCHTOWER_NOTIFICATION_URL=
TZ=Europe/Paris
